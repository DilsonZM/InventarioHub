{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/node_modules/pdfkit/js/data/**",
          "backend/node_modules/pdfkit/js/pdfkit.js",
          "backend/node_modules/pdfkit/js/reference.js",
          "backend/node_modules/pdfkit/package.json"
        ]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/low-stock",
      "schedule": "0 13 * * *"
    }
  ]
}
