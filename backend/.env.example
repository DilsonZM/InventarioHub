# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon key (publica): la usa el backend para validar credenciales contra Supabase Auth
SUPABASE_ANON_KEY=your-anon-key

# JWT Secret (sesion de la app)
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# URL publica de la app (links de recuperacion)
APP_URL=https://inventory-app-one-azure.vercel.app

# Server
PORT=3000
